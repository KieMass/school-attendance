# --- Server ---
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,exp://localhost:19000

# --- Database ---
DATABASE_URL=postgresql://pcls:pcls_dev_password@localhost:5432/pcls?schema=public

# --- Redis (rate limiting / notification queue) ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# --- QR token encryption (AES-256-GCM key, 32 bytes, base64) ---
# Generate with: openssl rand -base64 32
QR_ENCRYPTION_KEY=change_me_base64_32_byte_key
QR_DEFAULT_VALIDITY_MINUTES=120

# --- Password hashing ---
BCRYPT_SALT_ROUNDS=12

# --- Email (SMTP / SendGrid / Postmark compatible) ---
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASSWORD=change_me
EMAIL_FROM="President's College Leave System <noreply@presidentscollege.edu.gy>"

# --- SMS (Twilio) ---
TWILIO_ACCOUNT_SID=change_me
TWILIO_AUTH_TOKEN=change_me
TWILIO_FROM_NUMBER=+15005550006

# --- Push notifications (Firebase Cloud Messaging) ---
FIREBASE_PROJECT_ID=change_me
FIREBASE_CLIENT_EMAIL=change_me
# Escape newlines as \n when stored in a single env var
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Rate limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100
