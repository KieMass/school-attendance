# Used by docker-compose.yml to configure the Postgres container.
# Copy to .env at the repo root before running `docker compose up`.
POSTGRES_USER=pcls
POSTGRES_PASSWORD=pcls_dev_password
POSTGRES_DB=pcls

# Per-app configuration lives in apps/api/.env and apps/web/.env
# (copy from apps/api/.env.example and apps/web/.env.example).
